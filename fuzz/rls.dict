# Tokens the rls2fga pipeline recognises. Without these the fuzzer has to spell
# "CREATE POLICY" out of random bytes, which it never does.

# Statements that build the schema the translator reads.
"CREATE TABLE "
"CREATE POLICY "
"ALTER POLICY "
"CREATE FUNCTION "
"CREATE ROLE "
"CREATE SCHEMA "
"ALTER TABLE "
"DROP POLICY "
"ENABLE ROW LEVEL SECURITY"
"FORCE ROW LEVEL SECURITY"
"DISABLE ROW LEVEL SECURITY"

# Policy grammar.
" ON "
" TO "
" USING "
" WITH CHECK "
" FOR SELECT"
" FOR INSERT"
" FOR UPDATE"
" FOR DELETE"
" FOR ALL"
" AS PERMISSIVE"
" AS RESTRICTIVE"
" RENAME TO "
"PUBLIC"

# Column and constraint grammar.
" PRIMARY KEY"
" REFERENCES "
" NOT NULL"
" DEFAULT "
" UNIQUE"
" FOREIGN KEY"

# Types that steer the model, including the zoned one that earns a condition.
" UUID"
" TEXT"
" BOOLEAN"
" INTEGER"
" JSONB"
" TEXT[]"
" TIMESTAMPTZ"
" TIMESTAMP WITH TIME ZONE"
" TIMESTAMP"
" DATE"

# Caller accessors the classifier resolves.
"current_user"
"current_role"
"session_user"
"current_setting"
"pg_has_role"
"auth.uid()"
"auth.role()"
"auth.jwt()"

# Functions the harness registry declares. These are the only names that resolve to
# an accessor, so the role-threshold pattern is reachable through them alone.
"get_owner_role("
"auth_current_user_id()"
"auth_role()"
"owner_grants"
"team_members"
"grantee_owner_id"
"granted_owner_id"
"role_id"
"admin"
"app.current_user_id"
"request.jwt.claim.sub"
"authenticated"

# Shapes the recognisers key on.
" EXISTS "
" IN "
" ANY"
" ALL"
" NOT "
" AND "
" OR "
" JOIN "
" WHERE "
"SELECT 1 FROM "
" IS NULL"
" IS NOT NULL"
" = ANY("
" @> "
" ->> "
" -> "
"::text"
"::uuid"
"::jsonb"
"array_position"
"cardinality"
"coalesce"
"now()"

# Names the fixtures use, so a mutation lands on a real table or column.
"docs"
"notes"
"users"
"doc_members"
"team_memberships"
"projects"
"tasks"
"id"
"owner_id"
"user_id"
"doc_id"
"team_id"
"tenant_id"
"org_id"
"project_id"
"is_public"
"status"
"role"
"editor"
"viewer"

# Literals and boundaries.
"TRUE"
"FALSE"
"NULL"
"0"
"-1"
"2147483647"
