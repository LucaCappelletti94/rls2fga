CREATE TABLE users (
    id UUID PRIMARY KEY
);

CREATE TABLE teams (
    id UUID PRIMARY KEY
);

CREATE TABLE team_members (
    team_id UUID NOT NULL REFERENCES teams(id),
    user_id UUID NOT NULL REFERENCES users(id, grants, sequences, indexes, views, enums, d PUBLIC
    USING (get_owner_role(auth_current_user_id(), owner_id) >= 2 AND status = 'active');
