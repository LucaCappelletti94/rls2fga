CREATE TYPE mood AS ENUM ('calm', 'busy');

CREATE DOMAIN positive AS INT CHECK (VALUE > 0);

CREATE TABLE docs (
    d INT GENERATED ALWAYS AS (weight * 2) STORED,
    state mood,
    rank positive
);

CREATE INDEX docs_tenant_idx ON docs (tenant);
CREATE UNIQUE INDEX docs_o USING wner_login_uidx ON docs (owner_login);

