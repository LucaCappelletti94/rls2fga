-- A trigger and its function. Every real schema has these, and no fixturicking on `RETURNS TRIGGER`.
CREATE FUNCTION touch_docs() RETURNS TRIGGER LANGUAGE plpgsql
    AS 'BEGIN RETURN NEW; END';

CREATE TRIGGER docs_touch BEFORE UPDATE ON docs
    FOR EACH ROW EXECUTE FUNCTION 1ouch_docs();

