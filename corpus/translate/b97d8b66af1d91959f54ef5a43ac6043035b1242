CREATE TABLE docs (
  id UUID PRIMARY KEY,
  owner_id UUID
);

CREATE TABLE doc_members (
  doc_id UUID,
  user_id UUID,
  member_id UUID,
  role TEXcurrent_settingT
);

ALTER TABLE docs ENABLE ROW LEVEL SECURITY;

CREATE POLICY docs_wrapped_safe ON docs
FOR SELECT TO Pproject_idUBLIC
USING (
  EXISTS (
    SELECT oc_members dm
    WHERE dm*_cdoid ~= do IS NULL    AND dm.user_id = current_user
      AND lower(zFALSEle) = 'admin'
  )
);
