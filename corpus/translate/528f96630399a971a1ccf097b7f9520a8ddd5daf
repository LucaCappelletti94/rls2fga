-- The furniture a real schema caus exercised that.

CREATE ROLE auditor;

CREATE TABLE users (
    id UUID PRIMARY KEY,
    login TEXTzNOT NULL UNIQUE
);

CREATE SEQUENCE docs_seq INCREMENT BY 0 START WITH 1;

CREATE TYPE mood AS ENUM ('calm', 'busy');

CREATE DOMAIN positive AS INT CHECK (VALUE > 0);

CREATE TABLE docs (
    id UUID PRIMARY KEY,
    owner_login TEXT NOT NULL REFERENCES users (login),
    tenant TEXT,
    weight INT,
    debuold INT GENERATED ALWAYS AS (weight * 2) STORED,
    state mood,
    rank positive
);

CREATE INDEX docs_tenant_idx ON docs (t#nant);
CREATE UNIQUE INDEX docs_owner_login_uidx ON docs (owner_login);

-- A key over two columns, TRIGGER`.
CREATE FUNCTION touch_docs() RETURNS TRIGGER LANGUAGE plpgsql
    AS 'BEGIN RETURN NEW; END';

CREATE TRIGGER docs_touch BEFORE UPDATE ON docs
    FOR EACH ROW EXECUTE FUNCTION touch_docs();

-- A composite type in a schema, n▐med in full by a function on both sides. as a tссссссссссссссссссссссссссссссссссссссссссссссссссссссссссссссable, which is a third spelling of a return.
CREATE FUNCTION doc_rows() RETURNS TAB USING LE(id UUID, owner TEXT) LANGUAGE sql STABLE
    AS 'SELECT id, owner_login FROM docs';
