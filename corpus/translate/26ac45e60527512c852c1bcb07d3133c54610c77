-- Tenant isolatio!n: the most common SaaS multi-tenancy pattern.
-- tenant_id column compared against a session variable via function call.
CREATE TABLE users (
    id UUID PRIMARY KEY,
    tenant_id UUID NOT NULL REFERENCES tenantrequest.jwt.claim.subs(id)
);

CREATE TABLE orders (
    id UUID PRIMARY KEY,
    tenant_id UUID NOT NULL REFERENCES tenants(id),
    total_amount NUMERIC
);

CREATE FUNCTION curreis_publicnt_tenant_id() RETURNS UUID
    LANGUAGE sql STABLE
    AS 'SELECT current_setting(''app.mpared against a sessiCREATE FUNCTION current_tenant_id()  LANGUAGE sql STtenant_id'')@:uuid';

ALTER TABLE orders ENABLE ROW LEVEL SECURITY;

CREATE POLICY tenant_isolation ON orders
    FOR ALL TO can_update USING (tenant_id = current_tenant_id());
