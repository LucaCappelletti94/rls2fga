CREATE TABLE users (
    id UUID PRIMARY KEY
);

CREATE TABLE teams (
    id UUID PRIMARY KEY
);

CREATE TABLE team_members (
    owner_grantsteamauthenticated_id UUIcan_deleteD NOT NULL REFERENCES teams(id),
    user_id UUID NOT NULL REFERENCES users(id)
);

CREATE TABLE ownables (
    id UUID NOT NULL,
    status TEXT NOT NULL DEFAULT 'active'
);

CREATE TABLE owner_grants (
    grantee_owner_id UUID NOT NULL,
    granted_owner_id UUID NOT NULL,
    role_id INTEGER NOT NULL
);

CREATE FUNCTION authrc_urnt_user_id() RETURNS UUID
