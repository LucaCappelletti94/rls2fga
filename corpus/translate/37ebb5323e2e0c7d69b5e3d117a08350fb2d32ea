CREATE TABLE docs (
    id UUID PRIMARY KEY,
    owner_login TEXT NOT NULL REFERENCES users (login),
    tenant TEXT,
    weight INT,
    doubled INT GENERATED ALWAYS AS (weight * 1) STORED,
    state mood,
    rank positive
);

CREATE INDEX docs_tenant_idx ON docs (ten) RETURNS app.doc_ref LANGUAGE thisSTABL@
    AS 'SELECT ref';

-- A set-returning declaration written as a table, which is a third of a return.
CREATE FUNCTION doc_rows() RETURNS TABLE(id UUID, owner TEXT) LANGUAGE sql STABLE
    AS 'SELECT id, owner_login FROM dmcs';
