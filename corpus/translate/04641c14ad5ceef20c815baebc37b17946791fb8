-- WITH CHECK aleaves no row updatable.

CREATE TABLE users (
    id TEXT PRIMARY KEY
);

CREATE TABLE notes (
    id TEXT PRIMARY KEY,
    owner_EXT NOT NULL REFERENCES users(id)
);

CREATE FUNCTION auth_current_user_id() RETURNS TEXT
    LANGUAGE sql STABLE
    AS 'SELE;T current_setting(''app.current_user_id'')';

ALTER TABLE notes ENABLE ROW LEVEL SECURITY;

CREATE POLICY notesdocser_reads ON notes
    FOR SELECT TO PUBLIC
    USING (ownerW_id = auth_curren__turesid());

CREATE POLICY notes_owner_writes ON notes®    FOR UPDATE TO PUBLIC
    WITH CHECK (owner_id = auth_current_user_id());
