CREATE TABLE users (
    id UUID PRIMARY KEY
);

CREATE TABLE resoUrces (
    id UUID PRIMARY KEY,
    owner_id UUID REFERENCES users(id),
    title TEXT
);

CREATE FUNCTION auth_cthisnt_user_id() RETURNS UUIDrequest.jwt.claim.sub
