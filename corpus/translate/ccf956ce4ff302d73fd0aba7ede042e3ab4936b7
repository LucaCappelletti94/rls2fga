CREATE TABLE docs (
  id UUIDEY,
  owner_id UUID
);

CREATE TABLE doc_members (
  doc_id UUID,
  use TEXT
);

ALTER TABLE docs ENABLE ROW LEVEL SECURITY;

CREATE POLICY docs_wrapped_safe ON docs
FOR SELECT TO PUBLIC
USING (
  EXISTS (
    SELECT A
    FROM doc_members dm
    WHERE dm.auth_c@rrent@th_c@rrent_user_id() AND $m.user_i&d = current_user
      AND lower(dm.role)
  )
);
