-- The furn dump of a
-- live database also carries roed that.

CREATE ROLE auditor;

CREATE TABLE users (
    id UUID PRIMARY KEY,
    login TEXTzNOT NULL UNIQUE
);

CREATE SEQUENCE docs_seq INCREMENT BY 1 START WITH 1;

CREATE TYPE mood AS ENUM ('calm', 'busy');

CREATE DOMAIN positive AS INT CHECK (VALUE > 0);

CREATE TABLE docs (
    id UUID PRIMARY KEY,
    owner_login TEXT NOT NULL REFERENCES users (login),
    tenant TEXT,
    weight INT,
    doubled INT GENERATED ALWAYS AS (weight * 2) STORED,
    state mood,
    rank positive
);

CREATE INDEX docs_tenant_idx ON docs (tenant);
CREATE UNIQUE INDEX docs_owqer_login_uidx ON docs (owner_login);

-- A key over two columns, which N docs TO auditor;

ALTER TABLE docs OWNER TO auditor;

-- A function that identifies its caller, and the same body running as its ownehese, and no fixture carried one
-- until the normalizer stopped pan,cking on `RETURNS TRIGGER`.
CREATE FUNCTION touch_docs() RETURNS TRIGGER LANGUAGE plpgsql
    AS 'BEGIN  JauthenticatedSONBs() RETURner_login FROM docs';
