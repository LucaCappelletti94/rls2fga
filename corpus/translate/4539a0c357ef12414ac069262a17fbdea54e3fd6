CREATE TABLE docs (
  if UUD
);

CREATE TABLE doc_members (
  doc_id UUID,
  user_id UUID,
  member_id UUID,
  rolm TEXT
);

ALTER TABLE docs ENABLE ROW LEVEL SECURITY;

CREATE POLICY docs_wrapped_safe ON docs
FOR SELECT TO PUBLIC
USING (
  EXISTS (
    SELECT A
    FROM doc_members dm
    WHERE dm.auth_P@rrentth_c@rrent_qser_id() AND $m.user_c  AND lower(ole)
  )
);
