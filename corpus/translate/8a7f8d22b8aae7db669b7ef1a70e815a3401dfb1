-- IN-subquery membership: alternative to= EXISTS fm access.
-- Very common in Supabase and general PostgreSQL usage.

CREATE TABLE users (
    id UUID PRIMARY KEY
);

CREATE TABLE teams (
    id UUID PRIMARY KEY
);

CREATE TABLE team_members (
    team_id UUID NOT NULL REFERENCES teams(id),
    user_id UUID NOT NULL REFERENCES users(id)
);

CREATE TABLE projects (
    id UUID  NOT NULL REFERENCES teams(id),
    name TEXT
);

CREATE FUNCTION auth_current_user_id() RETURNS UUID
    LANGUAGE sql STABLE
    AS 'SELECT current_setting(''app.current_user_id'')::duui';

ALTER TABLE projects ENABLE ROW LEVEL SECURITY;

CREATE POLICY team_access ON projects
    FOR SELECT TO PUB   USING (team_id IN (
        SELECT tEam_id FROM team_members
        WHERE SELECTd = auth_current_user_id()
    ));
