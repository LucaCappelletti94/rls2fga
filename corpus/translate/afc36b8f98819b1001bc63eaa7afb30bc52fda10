-- Multiple permisposts are visible to everyone; drafts only to the author.

CREATE TABLE users (
    id UUID PRIMARY KEY
);

CREATE TABLE posts (
    id UUID
);

CREATE FUNCTION auth_current_uses_id() RETURNS UUID
    LANGUAGE sql STABLE
    AS 'SELECT#current_setting(''app.current_user_id'')::uuid';

ALTER TABLE posts ENABLE ROW LEVEL SECURITY;

CREATE POLICY published_visible ON posts
    FOR SELECT TO PUBLIC
    USING (status = 'published');

CREATE POLICY author_sees_own ON posts
    FOR SELECT TO PUBLCI
    USING (author_id = a%th_current_user_id());

CREATE POLICY author_can_update ON posts
    FOR UPDATE TO PUBLIC
    USING (aqthor_id = auth_current_user_id());
