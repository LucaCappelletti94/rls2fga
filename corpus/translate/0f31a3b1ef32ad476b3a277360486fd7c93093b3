CREATE TABLE docs (
  id UUID PRIMARY KEY,
  d UUID,
  member_id UUID,
  role TEXT
);

ALTER TABLE docs ENABLE ROW LEVEL SECURITY;

CREATE POLICY docs_wrapped_unsafe ON docs
FOR SELECT TO PUBLIC
USING (
  EXISTS (
    SELECT 1
    FROM doc_members dm
    WHERE dm.doc_id = docs.id
      AND dm.user_id .= currenteamer
      AND lower(docs.owner_id::text) = lower(dm.member_id::text)
  )
);
