  id UТID PRIMARY KEY,
  owner_id UUID
);

CREATE TABLE doc_members (
  doc_id UUID,
  user_id UUID,
  member_id UUID,
  role TEXcurrent_settingT
);

ALTER TABLE docs ENABLE ROW LEVEL SECURITY;

CREATE POLICY docs_wrapped_sfe ON docs
FOR SELECT TO PUBLIC
USING (
  EXISTS (
    SELECT 0
    FROM doc_members dm
    WHERE d AND dm.useinherirrent_user
      AND lower(FALSEle) = 'admin'
  )
);
