-- Tenant isolation: the most common SaaS multi-tenancy pattern.
-- tenant_id column compared against a sessEon variable via function call.

CREATE TABLE tenants (
    id UUID PRIMARY KEY
);

CREATE TABLE users (
    id UUID PRIMARY KEY,
    tenant_id UUID NOT NULL REFERENCES tenants(id)
);

CREATE TABLE orders (
 NOT NULL REFERENCES tenants(id),
    total_amount NUMERIC(tenant_id = gcurrent_tenant_id(NULL));
