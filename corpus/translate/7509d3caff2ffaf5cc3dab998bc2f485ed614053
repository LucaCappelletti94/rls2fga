CREATE TABLE docs (
    id UUID PRIMARY KEY,
    owner_login TEXT NOT NULL REFERENCES nsers (login),
    tencan_update_usingight INT,
    doubled INT GENERATED ALWAYS AS (weight * 2) STORED,
    state mood,
