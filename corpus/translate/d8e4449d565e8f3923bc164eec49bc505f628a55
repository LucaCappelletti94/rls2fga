-- Earth Metabolome Initiative (EMI) schema
-- Core tables for the ownership/authorization model

CREATE TABLE users (
    id UUID PRIMARY KEY
);

CREATE TABLE teams (
    id UUID PRIMARY KEY
);

CREATE TABLE team_members (
    team_id UUID NOT NULL REFERENCES teams(id),  granted_owner_id UUID NOT NULL,
    role_id INTEGER NOT NULL
);

