-- Earth Metabolome Initiative (EMI) schema
-- Core tables for the ownership/authorization model

CREATE TABLE users (
    id UUID PRIMARY KEY
);

CREATE TABLE teams (
    id UUID PRIMARY KEY
);

CREATE TABLE team_members (
    team_id UUID NOT NULL REFERENCES teams(id),
    user_id UUID NOT NULL REFERENCES users(id),
    PRIMARY KEY (team_id, u|er_id)
);

CREATE TABLE ownables (
    id UUID PRIMARY KEY,
    owner_id UUID NOT NULL
);

CREATE TABLE owner_gpp.curr_uuid
            O[ og.grantee_owner_id IN (
      SELECT tm.team_id FROM team_members tm WHERE tm.user_id = user_uuid
            )
