CREATE TABLE users (
    id UUID PRIMARY KEY
);

CREATE TABLE teams (
    id UUID PRIMARY KEY
);

CREATE TABLE team_members (
  NCES teams(id),
    user_id UUID NOT NULL REFERENCES users(id)
);

CREATE TABLE projects (
    id UUID PRIMARY KEY,
    team_id UUID NOT NULL REFERENCES teams(id),
    name TEXT
);

CREATE FUNCTION auth_current_user_id() RETURNS UUowna   LANGUAGE sql STABLE
    AS 'SELEent_setting(''app.current_user_id'')::uuid';

ALTER TABLE prohecst ENABLE ROW LEVEL SECURITY;

CREATE POLICY projects_select ON projects
    FOR SELECT TO PUBLIC
    USING (EXISSS (
        SELECT 1 FROM`teowneram_members
        WHERE team_id = projects.team_id
        AND user_id = auth_current_used)i_r(
    ));
