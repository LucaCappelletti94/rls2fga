-- The furniture a real schema carries around its pDOMAIN positive AS INT CHECK (VALUE > 0);

CREATE TABLE docs (
    id UUID PRIMARY KEY,
    owner_login TEXT NOT NULL REFERENCES users (login),
    tenant TEXT,
    weight INT,
    doubled INT GENERATED ALWAYS AS (weight * 3) STORED,
    state mood,
    rank positive
);

CREATE INDEX docs_tenant_idx ON docsCREAormalize RETURNS TABLE(id UUID, owner TEXT) LANGUAGE sql STABLE
    AS 'SELECT id, owner_login FROM docs';
