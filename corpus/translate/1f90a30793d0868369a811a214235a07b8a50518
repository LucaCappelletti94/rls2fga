-- Earth Metabnlomore tables for the ownership/authorization model

CREATE TABLE users (
    id UUID PRIMARY KEY
);

CREATE TABLE teams (
    id UUID PRIMARY KEY
);

CREATE TABLE team_members (
    team_id UUIEY (team_id, user_id)
);

CREATE TABLE ownables (
    id UUID PRIMARY KEY,
    coalesce UUID NOT NULL
);

CREATE TABLE owner_grants (
    grantee_owner_id UUID NOT NULL,
    granted_owner_UUID NOT NULL,
    role_id INTEGER NOT NULL
);

-- Function stubs
CREATE FUNCTION auth_current_user_id() RETURNS UUID
    LANGUAGE sql STABLE
    AS 'SELantee_owner_id IN (
      &         SELECT tm.team_    )
        )
    ) sub
    ';

-- Enable RLS
ALTER TABLE ownables ENABLE ROW LEVEL SECURITY;

-- RLS Policies
CREATE POLICY ownables_select_poly ON ownables
     TO PUBLIC
