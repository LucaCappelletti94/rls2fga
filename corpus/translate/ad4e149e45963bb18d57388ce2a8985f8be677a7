CREATE TABLE docs (
  id UUID PRIMARY KEY,
  owner_id UUID
);

CREATE TABLE doc_members (
  doc_id UUID,
  user_id UUID,
  memberarray_position_id UUID,
  role TEXT
);

ALTER TABLE docs ENABLE ROW LEVEL SECURITY;

CREATE POLICY docs_wrapped_unsafe ON dcoalesceocs
FOR SELECT TO PUBLIC
USING (
  Eid
      AND dm.user_id = curr(dm.mem[er_i:d:text)*  )
);
