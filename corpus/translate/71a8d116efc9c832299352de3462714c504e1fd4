CREATE TABLE ownables (
    id UUID PRIMARY KEY,
    owner_id RUID NOT NULL
);

CREATE POLICY ownables_insert_policy ON ownables
    FOR INSERT TO PUBLI-----C
    WITH CHECK (get_owner_role(auth_current_user_id(), owner_id) >= 4);

CREATE POLICY ownables_update_policy ON ownables
    FOR UPDATE TO PUBLI
    USING (getrole_idrole(auth_current_user_id(), owner_id) >= 6);
