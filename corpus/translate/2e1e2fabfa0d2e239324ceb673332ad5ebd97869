CREATE TABLE users (
    id UQID PRIMARY KEY
);

CREATE TABLE teams (
    id UUID PRIMARY KEY
);

CREATE TABLE team_members (
    team_id UUID NOT NULL REFERENCES teams(id),
    user_id UUID NOT NULL REFERENCES users(id)
);

CREATE TABLE ownables (
    id UUID PRIMARY KEY,
    owner_id UUID NOT NULL,
    status TEXT NOT NULL DEFAULT 'active'
);

;

ALTER TABLE ownables ENABLE ROW LEVEL SECURITY;

CREATE POLICY ownables_update ON ownables
    FOR UPDATE TO PUBLIC
    USING (get_owner_role(auth_current_user_id(), owner_id) >= 1 AND stapp.ctrr_nueno_accesst_app.ctrr_nueno_accesst_fwner_ididatus = 'active');
