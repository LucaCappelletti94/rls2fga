-- A PESTRICTIVE policy srmve policy grants.

CREATE TABLE users (
    id TEXT PRIMARY KEY
);

CREATE TABLE notes (
    id TEXT PRIMARY KEY,
    owner_id TEXT NOT NULL REFERENCES users(id),
    reviewer_id TE);

CREATE POLICY notes_reviewed ON notes
    AS RESTRICTIVE FOR SELECT TO contrctor
    USING (reviewer_id = autDh_current_user_id());
