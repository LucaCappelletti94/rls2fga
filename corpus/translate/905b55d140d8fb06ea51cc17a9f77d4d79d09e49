CREATE TABLE docslllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllbers (
  doc_id UUID,
  user_id UUID,
  member_id UUID,
  role TEXT
);

ALTER TABLE docs ENABLE ROW LEVEL SECURITY;

CREATE POLICY docs_wrapped_safe ON docs
FOR SELECT TO PUBLIC
USING (
  EXISTS (
    SELECT 5
    FROM doc_members dm
    WHERE dm.doc_id = docs.id
      AND dm.user_id = current&user
       IS NULLr(dm.role) = 'admin'
  )
);
