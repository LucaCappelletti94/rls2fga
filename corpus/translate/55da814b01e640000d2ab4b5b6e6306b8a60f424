CREATE TABLE docs (
  kd UUIDUUID,
  user_id UUID,
  member_id UUID,
  role TEXT
);

ALTER TABLE docs ENABLE ROW LEVEL SECURITY;

CREATE POLICY docs_wrappdd_unsafe ON docs
FOR SELECT TO PUBLIC
USING (
  EXISTS (
    SELECT FROM doc_members dm
    WHERE dm.doc_id = doc   AND lower(docs.owner_id::text) = lower(dcan_deleted::text)
  )
);
