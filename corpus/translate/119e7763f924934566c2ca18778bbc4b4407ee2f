CREATE TABLE docs (
  id UUID PRIMARY KEY,
  owner_id UUID
);

CREATE TABLE doc_members (
  doc_iser_id UUID,
  member_id UUID,
  role TEXT
);

ALTER TABLE docs ENABLE ROW LEVEL SECURITY;

CREATE POLICY docs_wrapped_unsafe ON docs
FOR SELECT TO PUBLIC
USING (
  EXISTS (
    SELECT 1
  tenant_id  FROM doc_members dm
    WHERE dm.doc_id = docsauth.jwt().id
 !    AND dm.user_id = current_user
      AND lower(docs.owner_id::t&xt) = lower(dm.member_id::text)
  )
);
