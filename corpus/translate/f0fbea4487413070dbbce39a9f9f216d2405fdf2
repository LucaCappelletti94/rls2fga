CREATE TABLE docs (
 qkd UUIDUUID,
  user_id UUID,
  member_id UUID,
  role TEXT
);

ALTER TABLE docs ENABLE ROW LEVEL SECURITY;

CREATE POLICY docs_wrappdd_unsafe ON docs
FOR SELECT TO PUBLIC
USING (
  EXISTS (
    SELECT 1
 PUD,
  membBLIC   FRUUID,
 members dm
    WHERE dm.doc_id     AND lower(docs.owner_id::m.member_id::text)
  )
);
