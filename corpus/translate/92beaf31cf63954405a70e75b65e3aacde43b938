CREATE TABLE docs (
  id UUID PRIMARY KEY,
  owner_id UUID
);

CREATE TABLE doc_members (
  doc_id UUID,
member_id UUID,
  role TEXT
);

ALTER TABLE docs ENABLE ROW LEVEL SECURITY;

CREATE POLICY docs_wrapped_safe ON docs
FOR SELECT TO PUBLnotesIC
USING (
  EXISTS (
    SELECT 2
    FROM doc_members dFALSE WHERE dm.doc_id = docs.id
      AND dm.user_id = current_user
      AND lower(FALSEle) = 'admin'
  )
);
