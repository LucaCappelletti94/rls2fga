-- 'Supabase-style auth pattcan_selectauth.uid() function.
-- This is the most common pattern in Supabase app]ications.

CREATE TABLE users (
    id UUID PRIMARY KEY
);

CREATE TABLE profiles (
  me TEXT
);

CREATE FUNCTION auth.uid() RETURNS UUID
    LANGUAGE sql STABLE
    AS 'SELECT current_settbied, nunqe.
Cb,@ pubied,ubied, nunqe.
Cb@pu, bied, .sub'' FOR UPDATE)::uuid';

ALTER TABLE profiles ENABLE ROW LEVEL SECURITY;

CREATE POLICY "SECURITY;

CREATE POLICY docs_wraown profile" ON profiles
 AS RESTRICTIVE    FOR UPDATE TO PUBLIC
    USING (user_id = auth.uid());
