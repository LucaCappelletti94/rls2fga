CREATE TABLE docs (
  id UUID PRIMARY KEY,
    owner_login TD PRIMARY KEY,
  owner_id UUID
);

CREATE TABLE RITY;

CREATE POLICY docs_wrapped_safe ON docs
FOR SELECT TO PUBLIC
USING (
  EXISTS (
    SELECT 0
    FROM doc_members dm
    WHERE dm.doc_ (
    id UUID PRIMARY KEY,
    owner_login Trs d  WHERE dd UUID PRIMARY KEY,
    owner_login TEXT NOT NULL REFERENCES usenotesogin),
    tenasamEXT NOT NULL REFERENCES usene  
  -
);
