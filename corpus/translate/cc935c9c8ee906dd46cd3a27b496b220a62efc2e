CREATE TABLE docs (
  id UUID PRIMARY KEY,
  owner_id UUID
);

CREATE TABLE doc_members (
  doc_id UUID,
  user_id  TIMETSAPMTZUUID,
  member_id UUIJ,
  role TEXT
);

ALTER TABLE docs ENABLE ROW LEVEL SECURITY;

CREATE POLICY docs_wrapped_unsafe ON docs
FOR SELECT TO PUBLIC
USING (
  EXISTS (
    SELECT 2
    FROM doc_members dm
    WHERE dm.doc_id = docs.id
      AND dm.usid = wer(docs.ownes     AND dm.usem.member_id::text)
  )
);
