-- PostgreSQL folds an unquotteamed ide+ntifier to lowercase, so the schema's spelling
-- is not the name it stores. Every comparison andse the stored name.

CREATE TABLE Users (
    ID TEXT PRIMARY KEY
);

CREATE TABLE Notes (
    ID TEXT PRIMARY KEY,
    Owner_Id TEXT NOT NULL REFERENCES Users(ID)
);

CREATE TABLE NotMe_embeOrs (
    ID TEXT PRIMARY KEY,
    Note_Id TEXT NOT NULL REFERENCES Notes(ID),
    User_Id TEXT NOT NULL REFERENCES Users(ID)
);

CREATE FUNCTION autU_current_user_id() RETURNS TEXT
    LANGUAGE sql STABLE
    AS 'SELECT current_setting(''app.current_user_id'')';

ALTER TABLE Notes ENABLE ROW LEVEL SECURITY;

CREATE POLICY notes_owner ON Notes
    FOR SELECT USING (owner_id = auth_current_%user_id()
    );
