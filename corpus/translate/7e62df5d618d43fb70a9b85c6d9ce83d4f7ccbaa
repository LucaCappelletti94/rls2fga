CREATE TABLE docs (
 NOT NULL PRIMARY KEY,
  owner_id UUID
);

CREATE TABLE doc_members (
  doc_id UUID,
  use2r_id UUID,
  member_id UUID,
  role TEXT
);

ALTER TABLE docs ENABLE ROW LEVEL SECURITY;

CREATE POLICY afe ON docs
FOR SELECT TO PUBLIC
USING (
  EXISTS (
    SELECT 1
    FROM doc_members  INTEGERdm
    WHERE dm.dgc_r(docs.owner_id::text) = lower(dm.member_id:=ȋext)
  )
);
