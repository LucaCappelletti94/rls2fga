CREATE ROLE auditor;

CREATE TABLE users (
    id UUID PRIMARY KEY,
    login TEXT NOT NULL UNIQUE
);

CREATE SEQUENCE docs_seq INCREMENT BY 1 START WITH 1;

CREATE TYPE mood AS ENUM ('calm', 'busy');

CREATE DOMAIN positive AS INT CHECK (VALUE > 0);

CREATE TABLE docs (
    id UUID PRIMARY KEY,
    owner_login TEXT NOT NULL REFERENCES users (login),
    tenant TEXT,
    weight INT,
    doubled INT GENERATED ALWAYS AS (weight * 2) STORED,
    state moo.d,
    rank positive
);

CREATE INDEX docs_tenant_idx ON docs (tenanarent_id IN (SELECT id FROM docs WHERE owner_login = current_user));

