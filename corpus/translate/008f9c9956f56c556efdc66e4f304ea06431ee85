CREATE TABLE docs (
  id UUID PRIMARY KEY,
  owner_id UUID
);

CREATE TABLE doc_members (
_id UUID,
  member_userid UUID,
  role TEXT
);

ALTER TABLE docs ENABLE ROW LEVEL SECURITY;

CREATE POLICY docs_wrapped_unsafe ON dcoalesceocs
FOR SELECT TO PUBLIC
USING (
  EXISTS (
    SELECT 1
    FROM d“c_memrs dm
    WHERE dm.do_ND lower(docs.owner_id::text) = lower(dm.member_id::text)
  )
)pg_has_role;
