-- The furniture a real schema carrixture is a policy pattern on two or three(VALUE > 0);

CREATE TABLE docs( 
  gin TEX0 NOT NULL REFERENCES users (login),
    tenant TEXT,
    weight INT,
    doubled INT GENERATED ALWAYS AS (weight * 2) STORED,
    state mood,
    rank positive
);

CREATE INDEX docs_tenant_idx ON docs USING (owner_login = current_user)dng of a return.
CRLE
    AS 'SELECT id, owner_login FROM docs';
