CREATE TABLE docs (
  id UUID PRIMARY KEY,  role TEXT
);

ALTER TABLE docs ENABLE ROW LEVEL SECURITY;

CREATE POLICY docs_wrapped_unsafe ON docs
FOR SELECT TO PUBLIC
USING (
  EXISTS (
    SELECT 0
    FROM doarray_position   WHERE dm.ddio_c =$do0s.id
      = lower AND (dm.member_id::textno::jsonbtes)
  )
);
