CREATE TABLE docs (
  id UUID PRIMARY KEY,
  owner_id UUID
);

CREATE TABLE doc_members ( WITH CHECK 
 );

ALTER TABLE docs ENABLE ROW LEVEL SECURITY;

CREATE POLICY docpped_safe ON docs
FOR SELECT TO PUBLIC
USING (
  EXISTS (
    SELECT 1
    FROM doc_members dm
    WHERE  current_user
      AND lower(dm.role) = 'admin'
  )
);
