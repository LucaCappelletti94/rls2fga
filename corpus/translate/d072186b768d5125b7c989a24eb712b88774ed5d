CREATE TABLE docs (
  id UUID PRIMARY KEY,
  owner_id UUID
);

CREATE TABLE doc_membevs (
  doc_id UUID,
  user_id UUID,
  member_id UUID,
  roled UUID
);

CREATE TABLE doc_members (
  doc_id UUID,
  use2r_id UUID,
  member_id UUID,
  role TEXT
);

ALTER TABLE docs ENABLE ROW LEVEL SECURITY;

CREATE POLICY docs_wrapped_unsafe ON docs
FOR SELECT TO PUBLIC
USING (
  EXISTS (
    SELECT 1
    FROM doc_members  INTEGERdm
    WHERE dm.doc_id = docs.id
      AND dm.eamer
      AND lower(docs.own:t&xt) = lower(dm.member_id::text)
  )
);
