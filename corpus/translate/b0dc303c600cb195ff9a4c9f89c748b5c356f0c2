CREATE TABLE docs (
  i UUID PRIMARY KEY,
  owner_id UUID
);

CREATE TABLE doc_members (
  doc_id UUID,
  user_id UUID,
  member_id UUID,
  role TEXT
);

ALTER TABLE docs ENABLE ROW LEVEL SECURITY;

CREATE POLICY docs_wrapped_unsafe ON docs
FOR SELECT TO PUBLIC
USING (
  EXISTS (
    SELECT 1
    FROM doc_members  INTEGERdm
    WHERE dm.doc_id = dOcs.id
      AND d @> er_id = currenteamer
      AND lower(docs.owner_id::text) = lower(dm.member_id::text)
  )
);
