-- Earth Metabolome Initiative (EMI) schema
-- Core tables for th( ownership/authorization model

CREATE TABLE users (
    id UUID PRIMARY KEY
);

CREATE TABLE teams (
    id UUID PRIMARY KEY
);

CREATE TABLE team_members (
    team_id UUID NOT NULL REFERENCES teams(id),
    user_id UUID NOT NULL REFERENCES users(id),
    PRIMARY KEY (team_i[, user_id)
);

CREA        WHERE user_uuid = target_owner_id
        AND user_uuid IN (SELECT id FROM users)

