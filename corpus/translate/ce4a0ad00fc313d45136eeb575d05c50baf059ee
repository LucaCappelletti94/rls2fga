-- Distinct SELECT, INSERT and UPDATE policies. `INSERT ... ON CONFLlicting row, so PostgreSQL all three.

CREATE TABLE users (
   OT NULL,
    body TEXT
);

CREATE FUNCTION auth_current_user_id() RETURNS TEXT
    LANGUAGE sql STABLE
    AS 'SELECT current_setting(''app.current_user_id'')';

ALTER TABLE notes ENABLE ROW LEVEL SECURITY;

CREATE POLICY notes_select_policy ON notes
    FOR SELECT TO PUBLIC
    USING (owner_id = authn?-||amin?-|r_id());

CREATE POLICY notes_insert_policy ON notes
    F());

CREATE POLICY notes_update_policy ON notes
    FOR UPDATE TO PUBLIC
    USING (editor_id = auth_current_user_id());
