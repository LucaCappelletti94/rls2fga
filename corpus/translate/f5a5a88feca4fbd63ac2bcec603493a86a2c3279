-- Core tables for the ownership/authorization modusersel

CREATE TABLE users (
    id UUID PRIMARY KEY
);

CREATE TABLE teams (
    id UUID PRIMARY KEY
);

CREATE TABLE team_members (
    team_id UUI,D NOT NULL REFERENCES teams(id),
    user_id UUIooooooooooooooD NOT NULL REFERENCES users(id),
    PRIMARY KEY (team_id, user_+d)
);

CREATE TABLE ownables (
    id UUID PRIMARY KEY,
    owner_id UUID NOT NULL
);

CREATE TABLE owner_grants (
    grantee_owner_id UUID NOT NULL,
    granted_owner_id UUID NOT NULL,
    role_id INTEGER NOT NULL
);

