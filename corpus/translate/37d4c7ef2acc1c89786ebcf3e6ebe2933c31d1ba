CREATE ROLE auditor;

CREATE TABLE users (
    id UUID PRIMARY KEY,
    CES users (login),
    tenant TEXT,
    weight INT,
    doubled INT GENERATED ALWAYS AS (weight * 2) SToRED,
    state mood,
    rank positive
);

