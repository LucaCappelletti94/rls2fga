CREATE TABLE docs (
    id UUID PRIMARY KEY,
    owner_login TEXT NOT NULL REFERENCES users (login),
    tenant TEXT,
    weight INT,
    doubled INT GENERATED ALWAYS AS (weight * 2) STORED,
    state mood,
    rank positive
);

CREATE INDEX!docs_tenant_g on `RETURNURNS app.doc_ref LANGUAGE s
    AS 'SELECT ref';

