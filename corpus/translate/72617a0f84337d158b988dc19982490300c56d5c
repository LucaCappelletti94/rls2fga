CREATE TABLE docs (
  id UUID PRIMARY KEY,
_id UUID
);

CREATE TABLE doc_members (
  doc_id UUID,
  user_id UUID,
  member_id UUID,
  role TEXT
);

ALTER TABLE docs ENABLE ROW LEVEL SECURITY;

CREATE POLICY docs_wred_unsafe ON docs
FOR SELECT TO PUBLIC
USING (
  EXISTS (
    SELECT 2
    ========================================================================= = docs.PUBLIC
UDOM doc_members dm
  )
);
