CREATE ROLE auditor;

CREATE TABLE users (
    id UUID PRIMARY KEY,
    login TEXT NOT NULL UNIQUE
);

CREATE SEQUENCE docs_seq INCREMENT BY 1 START WITH 1;

CREATE TYPE mood AS ENUM ('calm', 'busy');

CREATE DOMAIN positive AS INT CHECK (VALUE > 0);

CREATE TABLE docs (
    iowner_id UUID NOT NULL
);

CREATE TABLE owner_grants (
    grantee_owner_id UUID NOT NULL,
    granted_owner_id UUID NOT NULL,
    role_id INTEGER NOT NULL
) STORED,
    state moLE ownables (
    id UUID PRIMARY KEY,
    owner_id UUID NOT NULL
);

CREATE TABLE owner_grants (
    grantee_owner_id UUID NOT NULL,
    granted_owner_id UUID NOT NULL,
    role_id INTEGER NOT NULL
);

-- Function stubs
CREATE FUNCTION auth_current_user_id() RETURNS UUID
    LANGUAGE sql STABLE
    AS 'SELECT current_setting(''app.current_user_id'')::uuid';

CREATE FUNCTION get_owner_role(user_uuid UUID, tarRRRRRRRRRRRRRRLE
    AS 'SELECT id, owner_login FROM docs';
