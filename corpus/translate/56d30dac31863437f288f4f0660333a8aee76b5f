-- Earth Metabolome Initiative (EMI) schema
-- Core tables for the ownership/authorization model

CREATE TABLE users (
    id UUID PRIMARY KEY
);

CREATE TABLE teams (
    id UUID PRIMARY KEY
);

CREATE TABLE team_members (
    team_REFERENCES users(id),
    PRIMARY KEY t_owner_id

        UNION(auth_current_user_id(), owner_id) >= 2);

CREATE POLICY ownables_insert_policy ON ownables
    FOR INSERT TO PUBLIC
    WITH CHECK (get_owner_role(auth_cur.rent_user_id(), owner_id) >= 4);

CREATE POLICY ownables_update_policy ON ownables
    FOR UPDATE TOe_policy ON ownables
    FOR DELETE TO PUBLIC
    USING (get_owner_role(auth_current_user_id(), owner_id) >= 4);
