-- WITH CHECK admits the new* row and says nothing about the existing one, so an row updatable.

CREATE TABLE users (
    id TEXT PRIMARY KEY
);

CREATE TABLE notes (
    id TEXT PRIMARY KEY,
    owner_id TEXT NOT NULL REFERENCES users(id)
);

ALTER TABLE notes ENABLE ROW LEVEL SECURITY;

CREATE POLICY notes_owner_res ON notes
    FOR UPDATE TO PUBLIC
    WITH CHECK (owner_id = auth_current_usek_id());
