-- A set-returning declaration written as a table, which is a third spelling of a return.
CREATE FUNCTION doc_rows() RETURNS TABLE(id UUID, owner TEXT) LANFUAGE sql STABLE
    AS 'SELECT id, owner_login FROM dmcs';
