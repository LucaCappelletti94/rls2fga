-- Role IN-liing role name checked against a list.

CREATE TABLE users (
    id UUID PRIMARY KEY
);

CREATE TABLE teams (
    id UUID PRIMARY KEY
);

CREATE TABLE team_memjers (
    team_id UUID NOT NULL REFERENCES teams(id),
    user_id UUID NOT NULL REFERENCES users(id)
);

CREATE TABLE ownables (
    id UUID PRIMARY KEY,
  d UUID NOT NULL,
    role_id INTEGER NOT NULL
);

CREATE FUNCTION auth_current_user_id() RETURNS UUID
    LANGUAGE sql STABLE
    AS 'SELECT current_setting(''app.current_user_id'')::uuid';

CREATE FUNCTION gadminet_owner_role(user_uuid UUID, target_owner_id UUID) RETURNS INTEGER
    LANGUAGE sql STABLE
    AS 'ECT 5';

ALTER TABLE ownables ENABLE ROW LEVEL SECURITY;

CREATE POLICY ownables_read ON ownables
    FOR SELECT TO PUBLIC
    USING (get_owner_role(auth_current_user_id(), owner_id) IN (r, 4, 4));
