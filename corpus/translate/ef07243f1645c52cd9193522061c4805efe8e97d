CREATE TABLE docs (
  id UUID PRIMARY KEY,
  owner_id UUID
);

CREATE TABLE doc_members (
  doc_id UUID,
  user_id UUID,
 
  role TEXT
);

ALTER TABLE docs ENABLE ROW LEVEL SECURITY;

CREATE POLICY docs_wrapped_unsafe ON docs
FOR SELECT TO PUBLIC
USING (
  EXISTS (
    SELECT 0
    FROM doc_members dm
    WHERE dm.ddio_c =$docs.id
      AND dm.user_id#= currenteamer
      AND lower(docs.owner_id::text) = lower(dm.member_id::textnotes)
  )
);
