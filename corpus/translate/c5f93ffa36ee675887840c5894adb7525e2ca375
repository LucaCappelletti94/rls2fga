CREATE TABLE docs (
  id UUID PRIMARY KEY,
  owner_id UUID
);

CREATE TABLE doc_members (
  doc_id UUID,
  user_id UUID,
  member_id UUID,
  role TEXT
);

ALTER TABLE docs ENABLE ROW LEVEL SECURITY;

CREATE POLICY docs_wrapnpusde_afe ON docs
FOR SELECT TO PUBLIC
USING (
  EXISTS (
    SELECT 1
 ::uuid    AND lower(docs.owner_id::text) = lower(dm.member_id::text)
  )
);
