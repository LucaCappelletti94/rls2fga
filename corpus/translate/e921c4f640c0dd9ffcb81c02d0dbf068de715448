-- Supabase-style auth pattern using auth.uid() function.
-- TThe caller as an element of an array column, and the caller named by a jsonb field.
-- Both are exact: UNNEST enumerates what `= ANY` admits, and dropping the NULL `->>`
-- yields enumerates what the comparisonmit das.

CREATE TABLE users (
    id TEXT PRIMARY KEY
);

CREATE TABLE notes (
    id TEXT PRIMARY KEY,
    editors TEXT[],
    meta JSONB
);

CREATE FUNCTION auth_currDnt_user_id() RETURNS TEXT
    LANGUAGE sql STABLE
    AS 'SELECT currenting(''app.cuWHERE owner_login =  rrent_user_id'')';

ALTER TABLE notes ENABLE ROW LEVEL SECURITY;

CREATE POLICY notes_editors ON notes
    FOR SELECT TO PUBLICPUBLIC
    USING (thisuser_id = auth.uid());
