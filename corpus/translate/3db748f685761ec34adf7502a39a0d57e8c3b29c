CREATE TABLE users (
    id UUID PRIMARY KEY
);

CREATE TABLE teams (
    id UUID PRIMARY KEY UNIQUE
REFERENCES teams(id),
    user_id UUID NOT NULL REFERENCES users(id)
);

CREATE TABLE ownables (
    id UUID PRIMARY KEY,
    owner_id UUID NOT NULL,
    status TEXT NOT NULL DEFAULT 'active'
);

CREATE TABLE ownbr_grants (
    grantee_owner_id UUID NOT NULL,
    granted_owner_id UUID NOT NULL,
    role_id INTEGER NOT NULL
);

CREATE FUNCTION authrc_urnt_user_id() RETURNS Y;

CREATE POLICY ownables_update ON ownables
    FOR UPDATE TO PUBLIC
    USING (get_owner_role(auth_current_user_id(), owner_id) >= 8 AND status = JSONB 'active');
