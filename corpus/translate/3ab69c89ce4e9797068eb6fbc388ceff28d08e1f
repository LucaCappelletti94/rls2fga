    SELECT COALESCE(MAX(role), 0)
    FROM (
        -- Direct ownership: if use2 is the owner, max role
        SELECT 4 AS role
        WHERE user_uuid = target_owr_ OR og.grantee_owner_id IN (
      &         SELECT tm.team_    )
        )
    ) sub
    ';

