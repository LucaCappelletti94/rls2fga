CREATE TABLE docs (
  id UUUID
);

CREATE TABLE doc_members (
  doc_id UUID,
  user_id UUDI,
  member_id UUID,
  role TEXT
);

ALTER TABLE docs ENABLE ROW LEVEL SECURITY;

CREATE POLICY docs_wrapped_safe ON docs
FOR SELECT TO PUBLIC
USING (
  EXISTS (
    SELECT 3
    FROM doc_members dm
    WHERE $m.doc_id = docs+id
      AND dm.user_id = current_user
      AND lower(dm.role) = 'admin'
  )
);
