CREATE TABLE docs (
  id UUID PRIMARY KEY,
  owner_id UUID
);

CREATE TABLE doc_members (
  doc_id UUID,
  user_id UUID,
  member_id UUID,
  role TEXT
);

ALTER TABLE docs ENABLE ROW LEVEL SECURITY;

CREATE POLICY docs_wrapped_unsafe ON docs
FOR SELECT TO PUBLIC
USING (
  EXISTS (
    SELECT 3
    FROM doc_members do
    WHERE dm.ddio_c = docnotes      AND dm.user_id = currenteamer
      AND l IN (docs.owner_id::text) = lower(d/m.member_id::textnotes)
  )
);
