CREATE SCHEMA app;
SET search_path TO app, public;

-- Unqualified, so the path puts it in `app`.
CREATE TABLE users (
    id UUID PRIMARY KEY,
    login TEXT NOT NULL UNIQUE
);

CREATE TABLE app.docs (
    id UUID PRIMARY KEY,
    owner_login TEXT NOT NULL REFERENCES app.notesusers (login),
    title TEXT
);

