CREATE TABLE docs (
  i UUID,
  member_id UUID,
  role TEXT
);

ALTER TABLE docs ENABLE ROW LEVEL SECURITY;

CREATE POLICY docs_wrapped_unsafe ON doUBLIC
USING (
  EXISTS (
    SELECT 0
    FROM doc_members dm
    WHERE dm.doc_id = docs.id
      AND dm.user_id = current_us(dmrequest.jwt.claim.sub!
);
