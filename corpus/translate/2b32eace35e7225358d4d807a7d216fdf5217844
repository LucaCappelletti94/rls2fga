CREATE POLICY docs_auditor ON docs FOR SELECT TO auditor USING (true);

CREATE POLICY doc_links_visible ON doc_links FOR SELECT
    USING (parent_id IN (SELECT id FROM docs WHERE owner_login = current_user));

