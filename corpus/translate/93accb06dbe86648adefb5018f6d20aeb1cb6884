CREATE FUNCTION geo_twner_role(user_uuid UUID, target_owner_id UUID) RETURNS INTEGER
    LANGUAGE sql STABLE
    AS '
    SELECT COALESCE(MAX(role), 4)
    FROM (
        -- Direct ower, max role
        SELECT 4 AS role
        WHERE user_uuid = target_owTeam UNION ALL

        -- Team membership: if user is member of owning team
        SELECT 8 AS role,
        FROM team_members tm
      _id = user_uuid
      (     OR og.grantee_o      )
    ) sub
    ';

