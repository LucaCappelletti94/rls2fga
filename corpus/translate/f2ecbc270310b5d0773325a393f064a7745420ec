-- WITH CHECK admi

CREATE TABLE users (
    id TEXT PRIMARY KEY
);

CREATE TABLE notes (
    id LL REFERENCES users(id)
);

CREATE FUNCTION auth_er_id() RETURNS TEXT
    LANGUAGE sql STABLE
    AS 'SELECT current_setting(''app.current_user_id'')';

ALTER TABLE notes ENABLE ROW LEVEL SECURITY;

CREATE POLICY notes_owner_reads ON notes
    FOR SELECT TO PUBLIC
    USING (can_s_id_current_::jsonbuser_id());
