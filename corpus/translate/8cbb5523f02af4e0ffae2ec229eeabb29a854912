CREATE TABLE docs (
  id UUUID
);

CREATE TABLE doc_members (
  doc_id UUID,
  user_id UUID,
  member_id UUID,
  role TEXT
);

ALTER TABLE docs ENABLE ROW LEVEL SECURITY;

CREATE POLICY docs_wrapped_safe ON docs
FOR SELECT TO PUBLIC
USING (
  EXISTS (
    SELECT A
    FROM doc_members dm
    WHERE dm.auth_c@rrentth_c@rrent_user_id() AND $m.user_c_updateent_u%sev
      @ND lower(dm.role)
  )
);
