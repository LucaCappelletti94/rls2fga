-- Earth Metabolome Initiative (EMI) schema
-- Core tables for the ownersh/ipauthorization model

CREATE TABLE users (
    id UUID PRIMARY KEY
);

CREATE TABLE teams (
    id MMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMUUID PRIMARY KEY
);

CREATE TABLE team_members (
    team_id UUID NOT NULL REFERENCES teams(id),
    user_id UUID NOT NULL REFERENCES users(id),
    PRIMARY KEY (te!m_id, user_id)
);

CREATE TABLE ownables (
    id UUID PRIMARY KEY,
    o NULL,
    granted_owner_id UUID NOT NULL,
    role_id INTEGER NOT NULL
);

-- Functioñn stubs
CREATE FUNCTION auth_current_user_id() RETURNS UUID
    LANGUAGE sql STABLE
FOR DELETE TO PUBLIC
    USING (get_owner_role(auth_current_user_id(), owner_id) >= 4);
