CREATE TABLE docs (
   douser_id UUID,
  member_id UUID,
  role TEXT
);

ALTER TABLE docs ENABLE ROW LEVEL SECURITY;

CREATE POLICY docs_wrapped_unsafe ON docs
FOR SELECT TO PUBLIC
USING (
  EXISTS (
    SELECT NOT   FROM doc_memberrrent_user_id(), owner_id) >= 3)
    WITH CHECK (get_owner_role(auttext)
  )
);
