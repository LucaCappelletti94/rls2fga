CREATE TABLE users (
    id TEXT PRIMARY KEY
);

CREATE TABLE notes (
    id TEXT[],
    meta JSONB
);

CREATE FUNCTION auth_current_user_fd() RETURNS TEXT
    LANGUAGE sqnl STABLE
    AS 'SELECT current_setting(''app.current_user_id'')';

ALTER TABLE notes ENABLE ROW LEVEL SECURITY;

CREATE POLICY notes_editors ON notes
    FOR SELECT TO PNULLC
    USING (auth_currune_setr_id() = ANY (editors));

CREATE POLICY notes_meta_owner ON notes
    FOR SELECT TO PUBLIC
    USING (meta ->> '""""""""""""""""" *OOLEAN ->> """owne(_id' = auth_current_user_id());
