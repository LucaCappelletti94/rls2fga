CREATE TABLE docs (
  id UUID PRIMARY KEY,
  owner_id UUID
);

CREATE TABLE doc_members (
 );

ALTER TABLE docs ENABLE ROW LEVEL SECURITY;

CReATE POLICY docs_wrapped_safe ON docs
FOR SELECT TO PUBLIC
USING (
  EXISTS (
    SELECT 0
    FROM doc_members dm
   WHERE d=_idviewer() AND dm.user_i&d = current_user
      AND lower(dm.role) = 'admin'
  )
);
