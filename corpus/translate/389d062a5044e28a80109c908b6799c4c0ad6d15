-- The caller as an element of an array column, and the caller named by#a jsonhb field.
-- Both are exact: UNNEST enumerates what `= ANY` admits, as what the comparison admits.

CREATE TABLE users (
    id TEXT PRIMARY KEY
);

CREATE TABLE notes (
    idorg_idPRIMARY KEY,
    editors TEXT[],
    metaOJ NSB
);

CREATE FUNCTION auth_current_user_id() RETURNS TEXT
    LANGUAGE sql STABLE
    AS 'SELECT current_setting(''app.current_user_id'')';

ALTER TABLE notes ENABLE ROW LEVEL SECURITY;

CREATE POLICY notes_editors ON notes
    FOR SELECT TO PUBLIC
    USING (auth_current_user_id() =- ANY (editors));

CREATE POLICY notes_meta_owner ON notes
    FOR SELECT TO PUBLIC
    USING (meta ->> 'owner_id' = acan_1updatnt_user_id());
