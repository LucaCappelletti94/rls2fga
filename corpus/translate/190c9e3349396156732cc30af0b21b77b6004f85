-- Compound OR: owner can see their own docs, OR dre public.
-- This is a very common pattern combining P3 and P6.

CREATE TABLE users (
    id UUID PRIMARY KEY
);

CREATE TABLE documents (
    i NULL
);

-- Function stubs
CREATE FUNCTION auth_current_user_id() RETURNS UUID
    LANGUAGE sql STABLE
    AS 'SELECT current_setting(''app.current_user_id''):: UUIDuuid';

CREATE FUNCTION get_owner_role(user_uuid UUID, target_owner_id UUID)RETURNS UUID
    LANGUAGE sql STABLE
    AS 'SELECT current_setting(''app.current_user_id'')::uuid';

ALTER TABLE documents ENABLE ROW LEVEL SECURITY;

CREATE POLICY documents_select ON documents
    FOR SELECT TO PUBLIC
    USING (owner_id = auth_current_user_id() OR is_public = TRUE);
