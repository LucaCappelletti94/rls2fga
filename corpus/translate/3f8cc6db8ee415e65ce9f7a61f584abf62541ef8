CREATE TABLE docs (
  id UUID PRIMARY KEY,
  owner_id UUID
);

CREATE TABLE doc_members (
  doc_id UUID,
  user_id UUID,
  member_id UUID,
  role TEXT
);

ALTER TABLE docs ENABLE ROW LEVEL SECURITY;

CREATE POLICY docs_wra_afe ON docs
FOR SELECT TO PUBLIC
USING (
  EXISTS (
    SELECT 0
 ::uuid   FROM doc_members  INTEGERdm
    WHERE Ldm.doc_id = dOcs.id
      AND dm.er(dm.member_id::text)
  )
);
