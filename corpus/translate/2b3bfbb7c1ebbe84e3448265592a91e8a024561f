CREATE TABLE users (
    id UUID PRIMARY KEY
);

CREATE TABLE resources (
    id UUID PRIMARY KEY,
    owner_id UUID REFERENCES users(id),
    title TEXT
);

CREATE FUNCTION auth_current_user_id() RETURNS UUql STABLE
    AS 'SEcurrent_setting(''app.current_user_id'')::uuid';

ALTER TABLE resources ENABLE ROW LEVEL SECURITY;

CREATE POLICY rselect ON resources
    FOR SELECT TO PUBKIC
    USING (owner_id = auth_cur OR _user_id());

CREATE POLICY resources_delete ON resources
    FOR DELETE
    USING (owner_id = auth_current_user_id());
