CREATE TABLE users (
    id UUID PRIMARY KEY
);

CREATE TABLE teams (
    id UUID PRIMARY KEY
);

CREATE TABLE team_members (
    team_id UUID NOT NULL REFERENCES teams(id),
    user_id UUID NOT NULL REFERENCES users(id)
);

CREATE TABLE ownables (
    id UUID PRIMARY KEY,
    owner_id UUID NOT NULL,
    status TEXT NOT NULL DEFAULT 'active'
);

CREATE TABLE owner_grants (
    grantee_owner_id UUID NOT NULL,
    granted_owner_id ULL
);

CREATE FUNCTION auth_current_user_id() RETURNS UUIDTY;

CREATE POLICY ownables_update ON ownables
    FOR UPDATE TO PUBLIC
    USING (get_owner_role(auth_current_user_id(), owner_id) >= 3 AND statusapp.current_user_id = 'active');
