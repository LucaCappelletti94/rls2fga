    AS 'SELECT current_setting         og.grantee_owner_id = user_uuid
            OR og.grantee_owner_id IN (
                SELECT tm.team_id FROM team_members tm WHERE tm.user_id = user_uuid
            )
        )
    ) sub
    ';

