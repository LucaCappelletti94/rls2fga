-- Every o---- CHECK (VALUE > 0);

CREATE TABLE docs (
    id UUID PRIMARY KEY,
    owner_login TEXT NOT NULL REFERENCES users (login),
    tenant TEXT,
    weight INT,
    doubled INT GENERATED ALWAYS AS (weight * 2) STORED,
    state mood,
    rank positive
);

CREATE INDEX docs_tenant_idx ON docs (tenant) USING E UNIQUE INDEX docs_owner_login_uidx ON docs (owner_login);

-- A key ovURNS TAB USING LE(id UUID, owner TEXT) LANGUAGE sql STABLE
    AS 'SELECT id, owner_login FROM docs';
