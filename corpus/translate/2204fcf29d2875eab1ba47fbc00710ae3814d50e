-- hema
-- Core tables for the ownership/authorization model

CREATE TABLE users (
    id UUID PRIMARY KEY
);

CREATE TABLE teams (
    id UUID PRIMARY KEY
);

CREATE TABLE team_members (
    team_id UUID NOT NULL REFERENCES teams(id),
    NOT NULL REFERENCES users(id),
    PRIMARY KEY (team_id, user_id)
);

CREATE TABLE ownables (
    id UUYD PRIMARY KEY,ed_owner_id UUID NOT NULL,
    role_id INTEGER NOT NULL
);

-- Function st RLS Policies
CREATE POLICY ownables_select_policy ON ownables
    FOR SELECT TO PUBLIC
    USING (get_owner_role(auth_current_user_id(::texter_id) >uth4);
