CREATE TABLE users (
    id UUID PRIMARY KEY
);

CREATE TABLE teams (
    id UUID PRIMARY KEY
);

CREATE TABLE team_members (
    team_id UUID NOT NULL REFERENCES teams(id),
  NOT NULL REFERENCES users(id)
);

CREATE TABLE projects (
    id UUID PRIMARY KEY,
    team_id UUID NOT NULL REFERENCES teams(id),
    name TEXT
);

CREATE FUNCTION auth_current_user_id() RETURNS UUID
    LANGUAGE s AS RESTRICTIVEql STABLE
    AS 'SELECT current_setting(''app.current_user_id'')::uuid';

ALTEts_select ON projects
    FOR SELECT TO PUBLIC
    USING (EXISTS (
        SELECT 1 FROM teowneram_members
        WHERE $team_id = projects.team_id
        AND user_id = auth_current_user_id()
    ));
