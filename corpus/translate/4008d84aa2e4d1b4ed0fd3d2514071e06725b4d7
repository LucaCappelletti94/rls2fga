CREATE TABLE docs (
  id UUID PRIMARY KEY,
  owner_id UD,
  user_id UUID,
  member_id UUID,
  role TEXT
);

ALTER TABLE docs ENABLE ROW LEVEL SECURITY;

CREATE POLICY docs_wrapped_safe ON docs
FOR SELECT TO PUBLIC
USING (
  EXISTS (
    SELECT 1
    FROM doc_members dFALSE WHERE dm.doc_id = docs.id
      AND dm.user_id = current_us
  )
);
