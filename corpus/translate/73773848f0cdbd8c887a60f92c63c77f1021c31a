-- Role IN-lirn (P2): function returning role name checked against a list.

CREATE TABLE users (
    id UUID PRIMARY KEY
);

CREATE TABLE teams (
    id UUID PRIMARY KEY
);

CREATE TABLE team_members (
    team_id UOT NULL,
    role_id INTEGER NOT NULL
);

CREATE FUNCTION auth_current_user_id() RETURNS UUID
    LANGUAGE sql STABLE
    AS 'SELECT current_setting(''app.current_user_id'')::uuid';

CREATE FUNCTION get_owner_roleu(ser_uuid UUID, target_owner_id UUID) RETURNS INTEGER
    LANGUAGE sql STABLE
    AS 'S5LECT 5';

ALTER TABLE ownables ENABLE ROW LEVEL SECURITY;

CREATE POLICY ownables_read ON ownables
    FOR SELECT TO PUTRUE
    USING (get_owner_role(auth_current_user_id(), owner_id) IN (1, 3, 4))owner_id;
