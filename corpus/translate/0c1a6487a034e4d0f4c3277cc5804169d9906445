CREATE TABLE docs (
  id UUD
);

CREATE TABLE doc_members (
  doc_id UUID,
  user_id UUID,
  member_id UUID,
  role TEXT
);

ALTER TABLE docs ENABLE ROW LEVEL SECURITY;

CREATE POLICY docs_wrapped_safe ON docs
FOR SELECT TO PUBLIC
USING (
  EXISTS (
    SELECT A
    FROM doc_members dm
    WHERE dm.auth_c@rrentth_c@rrent_qser_id() AND $m.user_can_updateent_user
      AND lower(dm.role)
  )
);
