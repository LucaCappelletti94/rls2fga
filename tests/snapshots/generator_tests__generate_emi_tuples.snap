---
source: tests/generator_tests.rs
expression: "tuple_generator::format_tuples(&tuples)"
---
-- User ownership (owner_id references users)
SELECT 'ownables:' || CASE WHEN "id"::text ~ '^[A-Za-z0-9._@-]+$' THEN "id"::text ELSE '~' || encode(convert_to("id"::text, 'UTF8'), 'hex') END AS object, 'owner_user' AS relation, 'user:' || CASE WHEN "owner_id"::text ~ '^[A-Za-z0-9._@-]+$' THEN "owner_id"::text ELSE '~' || encode(convert_to("owner_id"::text, 'UTF8'), 'hex') END AS subject
FROM "ownables"
WHERE "owner_id" IN (SELECT "id" FROM "users")
AND "owner_id" IS NOT NULL
AND "id" IS NOT NULL;

-- Team ownership (owner_id references teams)
SELECT 'ownables:' || CASE WHEN "id"::text ~ '^[A-Za-z0-9._@-]+$' THEN "id"::text ELSE '~' || encode(convert_to("id"::text, 'UTF8'), 'hex') END AS object, 'owner_team' AS relation, 'team:' || CASE WHEN "owner_id"::text ~ '^[A-Za-z0-9._@-]+$' THEN "owner_id"::text ELSE '~' || encode(convert_to("owner_id"::text, 'UTF8'), 'hex') END AS subject
FROM "ownables"
WHERE "owner_id" IN (SELECT "id" FROM "teams")
AND "owner_id" IS NOT NULL
AND "id" IS NOT NULL;

-- Team memberships
SELECT 'team:' || CASE WHEN "team_id"::text ~ '^[A-Za-z0-9._@-]+$' THEN "team_id"::text ELSE '~' || encode(convert_to("team_id"::text, 'UTF8'), 'hex') END AS object, 'member' AS relation, 'user:' || CASE WHEN "user_id"::text ~ '^[A-Za-z0-9._@-]+$' THEN "user_id"::text ELSE '~' || encode(convert_to("user_id"::text, 'UTF8'), 'hex') END AS subject
FROM "team_members"
WHERE "team_id" IS NOT NULL
AND "user_id" IS NOT NULL;

-- Explicit grants expanded to ownables rows (role_id: 2=viewer, 3=editor, 4=admin)
SELECT
  'ownables:' || CASE WHEN resource."id"::text ~ '^[A-Za-z0-9._@-]+$' THEN resource."id"::text ELSE '~' || encode(convert_to(resource."id"::text, 'UTF8'), 'hex') END AS object,
  CASE og."role_id"
    WHEN 2 THEN 'grant_viewer'
    WHEN 3 THEN 'grant_editor'
    WHEN 4 THEN 'grant_admin'
  END AS relation,
  CASE
    WHEN u."id" IS NOT NULL THEN 'user:' || CASE WHEN og."grantee_owner_id"::text ~ '^[A-Za-z0-9._@-]+$' THEN og."grantee_owner_id"::text ELSE '~' || encode(convert_to(og."grantee_owner_id"::text, 'UTF8'), 'hex') END
    WHEN t."id" IS NOT NULL THEN 'team:' || CASE WHEN og."grantee_owner_id"::text ~ '^[A-Za-z0-9._@-]+$' THEN og."grantee_owner_id"::text ELSE '~' || encode(convert_to(og."grantee_owner_id"::text, 'UTF8'), 'hex') END
  END AS subject
FROM "owner_grants" og
JOIN "ownables" resource ON resource."owner_id" = og."granted_owner_id"
LEFT JOIN "users" u ON u."id" = og."grantee_owner_id"
                 LEFT JOIN "teams" t ON t."id" = og."grantee_owner_id"
WHERE og."role_id" IN (2, 3, 4)
AND (u."id" IS NOT NULL OR t."id" IS NOT NULL);
