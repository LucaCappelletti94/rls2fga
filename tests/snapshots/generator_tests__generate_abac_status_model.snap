model
  schema 1.1

type user

type nobody

type ownables
  relations
    define no_access: [nobody]
    define owner_id: [owner_grants_owner]
    define public_viewer: [user:*]
    define can_delete: no_access
    define can_insert: no_access
    define can_select: no_access
    define can_select_for_update: can_update
    define can_update: role_editor from owner_id and public_viewer and can_select
    define can_update_without_reading: role_editor from owner_id and public_viewer

type owner_grants_owner
  relations
    define grant_admin: [user, team]
    define grant_editor: [user, team]
    define owner_team: [team]
    define owner_user: [user]
    define role_admin: owner_user or member from owner_team or grant_admin or member from grant_admin
    define role_editor: role_admin or grant_editor or member from grant_editor

type team
  relations
    define member: [user]
