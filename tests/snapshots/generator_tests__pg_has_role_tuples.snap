---
source: tests/generator_tests.rs
expression: "tuple_generator::format_tuples(&tuples)"
---
-- Every docs row is judged by the scope scope_docs_select_14425117
SELECT 'docs:' || CASE WHEN "id"::text ~ '^[A-Za-z0-9._@-]+$' THEN "id"::text ELSE '~' || encode(convert_to("id"::text, 'UTF8'), 'hex') END AS object, 'scope_docs_select_14425117' AS relation, 'pg_role_scope:scope_docs_select_14425117' AS subject
FROM "docs"
WHERE "id" IS NOT NULL;

-- Scope scope_docs_select_14425117 admits PostgreSQL role 'editor', once for every docs row it judges
SELECT DISTINCT 'pg_role_scope:scope_docs_select_14425117' AS object, 'roles' AS relation, 'pg_role:editor' AS subject
FROM "docs";
